<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MathesisMauiApp.Controls"
             x:Class="MathesisMauiApp.Controls.PageHeader"
             x:Name="Root"
             x:DataType="controls:PageHeader">
    <VerticalStackLayout Spacing="4" Padding="0,4,0,8">
        <Label Text="{Binding Eyebrow, Source={x:Reference Root}}" StyleClass="Eyebrow" />
        <Label Text="{Binding Title, Source={x:Reference Root}}" StyleClass="H1" SemanticProperties.HeadingLevel="Level1" />
        <Label Text="{Binding Description, Source={x:Reference Root}}" StyleClass="Muted" />
    </VerticalStackLayout>
</ContentView>
