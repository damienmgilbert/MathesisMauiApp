<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MathesisMauiApp.Controls"
             xmlns:models="clr-namespace:MathesisMauiApp.Models"
             x:Class="MathesisMauiApp.Controls.FactTable"
             x:Name="Root"
             x:DataType="controls:FactTable">
    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Facts, Source={x:Reference Root}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:Fact">
                <Grid ColumnDefinitions="*,2*" ColumnSpacing="16" Padding="0,4">
                    <Label Text="{Binding Label}" StyleClass="Muted" VerticalOptions="Start" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="{Binding Value}" StyleClass="Code" LineBreakMode="CharacterWrap" />
                        <Label Text="{Binding Note}" StyleClass="Muted,Small" IsVisible="{Binding HasNote}" />
                    </VerticalStackLayout>
                </Grid>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
