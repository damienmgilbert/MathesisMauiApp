<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MathesisMauiApp.Controls"
             xmlns:models="clr-namespace:MathesisMauiApp.Models"
             x:Class="MathesisMauiApp.Controls.VerdictTable"
             x:Name="Root"
             x:DataType="controls:VerdictTable">
    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Rows, Source={x:Reference Root}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:VerdictRow">
                <Grid ColumnDefinitions="*,Auto,2*" ColumnSpacing="12" Padding="0,5">
                    <Label Text="{Binding Input}" StyleClass="Code" LineBreakMode="CharacterWrap" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Kind}" StyleClass="Muted,Small" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                        <Label Text="✓" StyleClass="Success" FontAttributes="Bold" IsVisible="{Binding IsValid}" />
                        <Label Text="✕" StyleClass="Danger" FontAttributes="Bold" IsVisible="{Binding IsInvalid}" />
                        <Label Text="{Binding Verdict}" LineBreakMode="WordWrap" />
                    </HorizontalStackLayout>
                </Grid>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
