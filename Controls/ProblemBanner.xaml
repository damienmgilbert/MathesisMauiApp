<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MathesisMauiApp.Controls"
             x:Class="MathesisMauiApp.Controls.ProblemBanner"
             x:Name="Root"
             x:DataType="controls:ProblemBanner"
             IsVisible="{Binding Message, Source={x:Reference Root}, Converter={StaticResource HasText}}">

    <Border StyleClass="DangerBox">
        <VerticalStackLayout Spacing="3">
            <Label Text="Unexpected problem" StyleClass="Danger" FontFamily="OpenSansSemibold" />
            <Label Text="{Binding Message, Source={x:Reference Root}}" />
            <Label Text="Mathesis reports bad input as an Outcome, so an exception here means a bug in the page or misuse of an API." StyleClass="Muted,Small" />
        </VerticalStackLayout>
    </Border>
</ContentView>
