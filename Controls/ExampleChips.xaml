<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MathesisMauiApp.Controls"
             xmlns:models="clr-namespace:MathesisMauiApp.Models"
             x:Class="MathesisMauiApp.Controls.ExampleChips"
             x:Name="Root"
             x:DataType="controls:ExampleChips">
    <VerticalStackLayout Spacing="6">
        <Label Text="{Binding Title, Source={x:Reference Root}}" StyleClass="Muted,Small" />
        <FlexLayout BindableLayout.ItemsSource="{Binding Samples, Source={x:Reference Root}}"
                    Wrap="Wrap"
                    Direction="Row"
                    JustifyContent="Start">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:Sample">
                    <Button Text="{Binding Label}"
                            StyleClass="Example"
                            Clicked="OnChipClicked"
                            CommandParameter="{Binding Text}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>
    </VerticalStackLayout>
</ContentView>
