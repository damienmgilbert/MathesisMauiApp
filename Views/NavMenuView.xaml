<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MathesisMauiApp.Models"
             xmlns:vm="clr-namespace:MathesisMauiApp.ViewModels"
             x:Class="MathesisMauiApp.Views.NavMenuView"
             x:DataType="vm:NavMenuViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <ContentView.Resources>
        <!-- One row of the menu; the selected one is tinted. -->
        <DataTemplate x:Key="NavItemTemplate" x:DataType="models:NavItem">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,9" Margin="8,1">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnItemTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                    <Label Text="{Binding Glyph}" FontSize="18" HorizontalTextAlignment="Center" VerticalOptions="Center" StyleClass="Accent" />
                    <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="20,28,20,16" Spacing="2">
            <Label Text="MATHESIS" StyleClass="Eyebrow" />
            <Label Text="Showcase" StyleClass="H1" />
            <Label Text="Exact mathematics, validated input" StyleClass="Muted,Small" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="2" Padding="0,0,0,24">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:NavGroup">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="{Binding Title}" StyleClass="Eyebrow" Margin="20,16,20,6"
                                   IsVisible="{Binding Title, Converter={StaticResource HasText}}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}"
                                                 BindableLayout.ItemTemplate="{StaticResource NavItemTemplate}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
