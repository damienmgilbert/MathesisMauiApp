<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Styles of the showcase pages. Apply them with StyleClass="...". Colours come from Colors.xaml. -->

    <OnPlatform x:Key="MonoFont" x:TypeArguments="x:String">
        <On Platform="WinUI" Value="Consolas" />
        <On Platform="Android" Value="monospace" />
        <On Platform="iOS" Value="Menlo" />
        <On Platform="MacCatalyst" Value="Menlo" />
    </OnPlatform>

    <!-- Labels -->
    <Style TargetType="Label" Class="H1">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="28" />
    </Style>
    <Style TargetType="Label" Class="H2">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style TargetType="Label" Class="H3">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="Label" Class="Eyebrow">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    </Style>
    <Style TargetType="Label" Class="Muted">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>
    <Style TargetType="Label" Class="Small">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="Label" Class="Danger">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
    </Style>
    <Style TargetType="Label" Class="Success">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
    </Style>
    <Style TargetType="Label" Class="Warning">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />
    </Style>
    <Style TargetType="Label" Class="Accent">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
    </Style>
    <Style TargetType="Label" Class="Code">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Label" Class="Result">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
    </Style>

    <!-- Borders -->
    <Style TargetType="Border" Class="Card">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style TargetType="Border" Class="Soft">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style TargetType="Border" Class="Field">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style TargetType="Border" Class="SuccessBox">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSoft}, Dark={StaticResource SuccessSoftDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style TargetType="Border" Class="DangerBox">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style TargetType="Border" Class="WarningBox">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarningSoft}, Dark={StaticResource WarningSoftDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style TargetType="Border" Class="AccentBox">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style TargetType="Border" Class="Chip">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="9,3" />
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button" Class="Example">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="MinimumHeightRequest" Value="30" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style TargetType="Button" Class="Secondary">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    </Style>
    <Style TargetType="Button" Class="Ghost">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinimumHeightRequest" Value="32" />
    </Style>

    <!-- Inputs inside a "Field" border draw no chrome of their own. -->
    <Style TargetType="Entry" Class="Mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style TargetType="Editor" Class="Mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

</ResourceDictionary>
