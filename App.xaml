<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:MathesisMauiApp.Converters"
             x:Class="MathesisMauiApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/Showcase.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- CommunityToolkit.Maui converters shared by every page. -->
            <toolkit:InvertedBoolConverter x:Key="Not" />
            <toolkit:IsNotNullConverter x:Key="IsNotNull" />
            <toolkit:IsNullConverter x:Key="IsNull" />
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="HasText" />
            <converters:HasItemsConverter x:Key="HasItems" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
